; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dimenship"
run/main_scene="res://scenes/StartScreen.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

; The background music, which has to outlive the scene that started it: the start screen and the
; shell are separate scenes, and a track that restarted on ChangeSceneToFile would announce the
; scene change the score is there to smooth over.
MusicPlayer="*res://scripts/ui/MusicPlayer.cs"

[audio]

; Stated rather than left to the implicit default, because the Sound settings write to the Music
; and SFX buses by name and a layout that silently failed to load would leave them writing to
; buses that do not exist.
buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Dimenship"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
