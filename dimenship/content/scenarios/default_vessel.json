{
  "id": "default_vessel",
  "label": "Dimenship",
  "notes": "The vessel the shell starts on, built to the GDD's production layer: one global Resource Storage in the middle, an interconnected array of factories, Matter Reactors as the separating tier, and Mission Docks joined to storage and to nothing else. The flow the GDD names is missions - docks - storage - matter reactors - storage - factories - storage. Missions do not exist, so the vessel starts stocked with the Matter Mix they would have recovered. Two things here are deliberately inert, because the systems behind them do not exist: a Matter Reactor separates and draws power but makes none, and a Mission Dock has no schematic at all - which is how the missing acquisition loop stays visible on the graph instead of being quietly drawn as if it worked.",

  "energyCapacity": 10000,

  "hold": "resource_storage",

  "storages": [
    {
      "id": "resource_storage",
      "archetype": "global_hold",
      "nameOverride": null,
      "placement": { "column": 2, "row": 2, "badge": "2" },
      "initial": [
        { "item": "matter_mix", "quantity": 3600000 },
        { "item": "basic_metals", "quantity": 40000 }
      ],
      "notes": "The vessel starts stocked rather than empty: the chain has to be running when the player first looks at it, and with no missions there is nowhere else the opening Matter Mix could come from. 3,600,000 against the 500 a tick the two reactors separate is two operational hours before the shortage bites."
    },

    {
      "id": "extractor_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Extractor Buffer",
      "initial": [],
      "notes": "A facility's buffer has no cell of its own. It is drawn inside the card of the facility that works it, so a route ending at the buffer ends at that facility - which is what keeps a vessel of nine facilities from drawing eighteen cards to say the same thing."
    },
    {
      "id": "reactor_a_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Reactor Alpha Buffer",
      "initial": []
    },
    {
      "id": "reactor_b_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Reactor Beta Buffer",
      "initial": []
    },
    {
      "id": "factory_a_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Factory Alpha Buffer",
      "initial": []
    },
    {
      "id": "factory_b_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Factory Beta Buffer",
      "initial": []
    },
    {
      "id": "factory_c_buffer",
      "archetype": "facility_buffer",
      "nameOverride": "Factory Gamma Buffer",
      "initial": []
    },
    {
      "id": "dock_a_hold",
      "archetype": "facility_buffer",
      "nameOverride": "Mission Dock Alpha Hold",
      "initial": []
    },
    {
      "id": "dock_b_hold",
      "archetype": "facility_buffer",
      "nameOverride": "Mission Dock Beta Hold",
      "initial": []
    }
  ],

  "facilities": [
    {
      "id": "extractor_01",
      "archetype": "hydrogen_extractor",
      "nameOverride": null,
      "localStorage": "extractor_buffer",
      "initialSchematic": "extract_hydrogen",
      "builtAtStart": true,
      "placement": { "column": 2, "row": 0, "badge": "1" },
      "notes": "Directly above Resource Storage, so the one route that brings anything aboard without a mission is a straight line down the middle rather than an elbow crossing the reactors' lines. It carries no queued task and cannot: its archetype is not commandable, and what it produces is what it is configured with. That configuration is its standing order."
    },

    {
      "id": "reactor_a",
      "archetype": "matter_reactor",
      "nameOverride": "Matter Reactor Alpha",
      "localStorage": "reactor_a_buffer",
      "initialSchematic": "separate_basic",
      "builtAtStart": true,
      "placement": { "column": 0, "row": 2, "badge": "3A" },
      "notes": "Two reactors, two modes. The array's output mix is a consequence of how they are configured, which is the decision the GDD wants a reactor to present."
    },
    {
      "id": "reactor_b",
      "archetype": "matter_reactor",
      "nameOverride": "Matter Reactor Beta",
      "localStorage": "reactor_b_buffer",
      "initialSchematic": "separate_technical",
