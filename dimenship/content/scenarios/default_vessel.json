  "unlockedSchematics": [
    "extract_hydrogen",
    "separate_basic",
    "separate_technical",
    "synthesize_basic",
    "press_components",
    "assemble_modules",
    "assemble_frames"
  ],

  "initialTasks": [
    {
      "schematic": "separate_basic",
      "executor": "reactor_a",
      "notes": "No runs field, and that is the point: a standing order runs for as long as its inputs keep arriving. It is what an executor does absent instruction, and a program is what changes it - built the other way round, the vessel's baseline behaviour would depend on a program being installed and enabled."
    },
    { "schematic": "separate_technical", "executor": "reactor_b" },
    { "schematic": "press_components", "executor": "factory_a" },
    { "schematic": "assemble_modules", "executor": "factory_b" },
    { "schematic": "assemble_frames", "executor": "factory_c" }
  ],

  "initialTransfers": [
    { "item": "hydrogen", "from": "extractor_buffer", "to": "resource_storage", "executor": "extractor_out" },

    { "item": "matter_mix", "from": "resource_storage", "to": "reactor_a_buffer", "executor": "reactor_a_feed" },
    { "item": "basic_metals", "from": "reactor_a_buffer", "to": "resource_storage", "executor": "reactor_a_return" },
