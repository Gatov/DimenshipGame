<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Dimenship.Replay.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Dimenship.Replay\Dimenship.Replay.csproj" />
  </ItemGroup>
  <!-- The shipped content tree, copied beside the test binary as the kernel suite does. -->
  <ItemGroup>
    <None Include="..\..\dimenship\content\**\*.json" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Held at 4.5.1 for the same reason as the kernel suite: 4.6.0 makes Assert.Throws ambiguous. -->
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
</Project>
